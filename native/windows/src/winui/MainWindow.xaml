<Window
    x:Class="AgentManagerWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Agent Manager">

    <!-- Native Windows 11 look (issue #72): Segoe Variable type ramp (see App.xaml) over
         the Mica system backdrop (see code-behind), card surfaces with
         rounded corners, 12px outer / 8px inner spacing. Every brush is a
         ThemeResource, so the System/Dark/Light setting repaints the whole
         window. Same controls and handlers as before: no behavior change. -->
    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: drag region via SetTitleBar in code-behind.
             Caption buttons overlay the right side, so content stays left. -->
        <Grid x:Name="AppTitleBar" Height="32">
            <TextBlock Text="Agent Manager"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Roster card (issue #73): New Session button, session search,
                 then live runs grouped needs-input / idle / working with
                 non-live history collapsed at the end; save, theme, find,
                 and the status line sit below the groups. One shared
                 SelectionChanged handler keeps a single selection across
                 the four lists. -->
            <Border Grid.Column="0"
                    Margin="12,0,0,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid Padding="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Runs"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <Button x:Name="NewButton"
                            Grid.Row="1"
                            Content="New Session"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="NewButton_Click"/>
                    <TextBox x:Name="FilterBox"
                             Grid.Row="2"
                             PlaceholderText="Search sessions"
                             TextChanged="FilterBox_TextChanged"/>
                    <!-- Group lists size to content (inner scrolling off)
                         inside one outer scroller; history stays collapsed
                         until the user expands it. All four headers always
                         show, so the group order is stable even when a
                         group is empty. -->
                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollMode="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="NeedsHeader"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ListView x:Name="NeedsInputList"
                                      SelectionMode="Single"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      SelectionChanged="Roster_SelectionChanged"/>
                            <TextBlock x:Name="IdleHeader"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ListView x:Name="IdleList"
                                      SelectionMode="Single"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      SelectionChanged="Roster_SelectionChanged"/>
                            <TextBlock x:Name="WorkingHeader"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ListView x:Name="WorkingList"
                                      SelectionMode="Single"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      SelectionChanged="Roster_SelectionChanged"/>
                            <Expander x:Name="HistoryExpander"
                                      Header="History"
                                      IsExpanded="False"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                                <ListView x:Name="HistoryList"
                                          SelectionMode="Single"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          SelectionChanged="Roster_SelectionChanged"/>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="SaveButton"
                            Grid.Row="4"
                            Content="Save"
                            HorizontalAlignment="Stretch"
                            Click="SaveButton_Click"/>
                    <ComboBox x:Name="ThemeBox"
                              Grid.Row="5"
                              Header="Theme"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="ThemeBox_SelectionChanged">
                        <x:String>System</x:String>
                        <x:String>Dark</x:String>
                        <x:String>Light</x:String>
                    </ComboBox>
                    <TextBox x:Name="FindBox"
                             Grid.Row="6"
                             PlaceholderText="Find in terminal"/>
                    <Button x:Name="FindNextButton"
                            Grid.Row="7"
                            Content="Find next"
                            HorizontalAlignment="Stretch"
                            Click="FindNextButton_Click"/>
                    <!-- Status line: failures (spawn, save, clipboard)
                         must stay visible (fail-visible principle), so it
                         lives at the sidebar bottom now that the terminal
                         fills the right pane. -->
                    <TextBlock x:Name="StatusText"
                               Grid.Row="8"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- Terminal card (issue #73): the output surface fills the
                 full height of the right pane; no status label beneath. -->
            <Border Grid.Column="1"
                    Margin="12,0,12,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer x:Name="TermScroll"
                              Padding="12"
                              HorizontalScrollMode="Auto"
                              VerticalScrollMode="Auto">
                    <TextBox x:Name="TermBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas, monospace"
                             FontSize="13"
                             KeyDown="RootGrid_KeyDown"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
