<Window
    x:Class="AgentManagerWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    Title="Agent Manager">

    <!-- Native Windows 11 look (issue #72): Segoe Variable type ramp (see App.xaml) over
         the Mica system backdrop (see code-behind), card surfaces with
         rounded corners, 12px outer / 8px inner spacing. Every brush is a
         ThemeResource, so the window follows the system theme. Same controls and handlers as before: no behavior change. -->
    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: drag region via SetTitleBar in code-behind.
             Caption buttons overlay the right side, so content stays left. -->
        <Grid x:Name="AppTitleBar" Height="32">
            <TextBlock Text="Agent Manager"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn"
                                  Width="320"
                                  MinWidth="220"
                                  MaxWidth="480"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Roster card (issue #73): New Session button, session search,
                 then live runs grouped needs-input / working / idle (macOS
                 parity) with non-live history collapsed at the end; the
                 status line sits below the groups. One shared
                 SelectionChanged handler keeps a single selection across
                 the four lists. -->
            <Border Grid.Column="0"
                    Margin="12,0,0,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid Padding="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Runs"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <Button x:Name="NewButton"
                            Grid.Row="1"
                            Content="New Session"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="NewButton_Click"/>
                    <TextBox x:Name="FilterBox"
                             Grid.Row="2"
                             PlaceholderText="Search sessions"
                             TextChanged="FilterBox_TextChanged"/>
                    <!-- Group lists size to content (inner scrolling off)
                         inside one outer scroller; history stays collapsed
                         until the user expands it. All four headers always
                         show, so the group order is stable even when a
                         group is empty. Order is Needs input, Working,
                         Idle (macOS parity). -->
                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollMode="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="NeedsHeader"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ListView x:Name="NeedsInputList"
                                      SelectionMode="Single"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      SelectionChanged="Roster_SelectionChanged"/>
                            <TextBlock x:Name="WorkingHeader"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ListView x:Name="WorkingList"
                                      SelectionMode="Single"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      SelectionChanged="Roster_SelectionChanged"/>
                            <TextBlock x:Name="IdleHeader"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ListView x:Name="IdleList"
                                      SelectionMode="Single"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      SelectionChanged="Roster_SelectionChanged"/>
                            <Expander x:Name="HistoryExpander"
                                      Header="History"
                                      IsExpanded="False"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                                <ListView x:Name="HistoryList"
                                          SelectionMode="Single"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          SelectionChanged="Roster_SelectionChanged"/>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Status line: failures (spawn, save, clipboard)
                         must stay visible (fail-visible principle), so it
                         lives at the sidebar bottom now that the terminal
                         fills the right pane. -->
                    <TextBlock x:Name="StatusText"
                               Grid.Row="4"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- Resize grip between the roster card and the terminal card:
                 a keyboard-focusable Thumb so the sidebar resizes by drag
                 AND by arrow keys (keyboard parity: Left/Right move in 8px
                 steps, Home/End jump to min/max). Drag deltas go through
                 SidebarThumb_DragDelta, key presses through
                 SidebarThumb_KeyDown; both clamp the SidebarColumn width
                 to 220..480px and persist it in LocalSettings. -->
            <primitives:Thumb x:Name="SidebarThumb"
                              Grid.Column="1"
                              Width="12"
                              Margin="0,0,0,12"
                              Background="Transparent"
                              BorderThickness="0"
                              DragDelta="SidebarThumb_DragDelta"
                              KeyDown="SidebarThumb_KeyDown"
                              AutomationProperties.Name="Resize sidebar"
                              IsTabStop="True">
                <ToolTipService.ToolTip>
                    <ToolTip Content="Drag to resize the sidebar"/>
                </ToolTipService.ToolTip>
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Grip"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Grip"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Grip"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Grip"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Rectangle x:Name="Grip"
                                       Width="4"
                                       RadiusX="2"
                                       RadiusY="2"
                                       HorizontalAlignment="Center"
                                       Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                       Opacity="0"/>
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>

            <!-- Terminal card (issue #73): the output surface fills the
                 full height of the right pane; no status label beneath. -->
            <Border Grid.Column="2"
                    Margin="12,0,12,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer x:Name="TermScroll"
                              Padding="12"
                              HorizontalScrollMode="Auto"
                              VerticalScrollMode="Auto">
                    <TextBox x:Name="TermBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas, monospace"
                             FontSize="13"
                             KeyDown="RootGrid_KeyDown"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
