<?xml version="1.0" encoding="utf-8"?>
<!-- Agent Manager — WinUI 3 shell (issue #64). Unpackaged C++/WinRT app:
  no MSIX/installer (see the CI/packaging issue); CI builds the exe with
  msbuild after `msbuild -t:restore` pulls Microsoft.WindowsAppSDK.
  The core staticlib (agent_manager.lib, from building the cargo lib
  target) links in via CoreLibDir (override with /p:CoreLibDir=dir). -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="NuGet">
    <!-- Native restore contract, mirroring the official unpackaged C++ sample
      (WindowsAppSDK-Samples Samples/Unpackaged/cpp-console-unpackaged,
      refs #64): without NuGetTargetMoniker, restore writes a framework the
      build's ResolveNuGetPackageAssets does not expect (run 36332867325:
      `does not reference "UAP,Version=v10.0"`). The sample uses
      native,Version=v0.0 (plain Win32 console); this project keeps
      ApplicationType=Windows Store for native XAML codegen, so the build
      demands UAP v10.0 and restore must write it. All four restored packages
      accept UAP10.0 (WebView2 declares empty native0.0 + UAP10.0 groups;
      AppSDK/CppWinRT/BuildTools are framework-agnostic). -->
    <NuGetTargetMoniker>UAP,Version=v10.0</NuGetTargetMoniker>
    <NuGetTargetPlatformIdentifier>Windows</NuGetTargetPlatformIdentifier>
    <NuGetTargetPlatformVersion>$(WindowsTargetPlatformVersion)</NuGetTargetPlatformVersion>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{A6B4C2E1-8F3D-4B9A-9E5C-64D2A1F0B3C7}</ProjectGuid>
    <RootNamespace>AgentManagerWinUI</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <ProjectName>AgentManagerWinUI</ProjectName>
    <!-- Native XAML rules (runs 36330973198/36331376776, refs #64):
      *.xaml.g.h codegen comes from VS's inbox
      Microsoft.Windows.UI.Xaml.Cpp.targets, imported only when
      ApplicationType is Windows Store (without it: C1083 on
      App.xaml.g.h/MainWindow.xaml.g.h). windows-latest is a VS 2026
      (v18) image whose native toolset is v145 (MSVC 14.51, in-box);
      the v143 UWP overlay is absent and uninstallable there
      (actions/runner-images#14101: installer modify adding
      ComponentGroup.UWP.VC.v143 exits 0 yet installs nothing), so the
      project tracks v145 instead of v143. Unpackaged desktop exe (no
      MSIX) is kept via AppContainerApplication=false +
      AppxPackage=false/WindowsPackageType=None. -->
    <AppContainerApplication>false</AppContainerApplication>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <!-- WinUI 3, unpackaged: a plain exe, no MSIX (non-goal in #64). -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AppxPackage>false</AppxPackage>
    <!-- Tell NuGet this is PackageReference style (run 36331814809, refs #64):
      without it, restore-style auto-detection can drift from the build-time
      ResolveNuGetPackageAssets UAP check. Same line ships in PowerToys'
      unpackaged WinUI 3 C++ projects, which build green on hosted runners. -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <TargetFrameworks>UAP,Version=v10.0</TargetFrameworks>
    <!-- Do NOT set CppWinRTEnabled: 'true' flips the CppWinRT NuGet targets to
      VS-inbox mode (CppWinRTPackage=false), which runs cppwinrt from the package's
      build/native dir instead of bin and fails CppWinRTMakePlatformProjection
      with MSB3073 (cppwinrt not recognized, exit 9009; run 36329571683).
      Left unset, the NuGet layout (CppWinRTPath = package bin) is used. -->
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Directory holding agent_manager.lib (default: cargo's debug dir). -->
    <CoreLibDir Condition="'$(CoreLibDir)' == ''">$(ProjectDir)..\..\target\debug</CoreLibDir>
    <OutDir>$(ProjectDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <AdditionalIncludeDirectories>$(ProjectDir)src;$(ProjectDir)src\winui;$(ProjectDir)..\..\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalLibraryDirectories>$(CoreLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>agent_manager.lib;ws2_32.lib;userenv.lib;bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <Manifest>
      <AdditionalManifestFiles>$(ProjectDir)app.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
    <Midl>
      <HeaderFileName>%(Filename).g.h</HeaderFileName>
    </Midl>
  </ItemDefinitionGroup>
  <ItemGroup>
    <Midl Include="src\winui\App.idl" />
    <Midl Include="src\winui\MainWindow.idl" />
    <ApplicationDefinition Include="src\winui\App.xaml">
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="src\winui\MainWindow.xaml">
      <SubType>Designer</SubType>
    </Page>
    <ClInclude Include="src\winui\pch.h" />
    <ClInclude Include="src\winui\App.xaml.h" />
    <ClInclude Include="src\winui\MainWindow.xaml.h" />
    <ClInclude Include="src\core_bridge.h" />
    <ClInclude Include="src\feed.h" />
    <ClInclude Include="src\terminal_keys.h" />
    <ClInclude Include="src\json_mini.h" />
    <ClCompile Include="src\winui\pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\winui\App.xaml.cpp" />
    <ClCompile Include="src\winui\MainWindow.xaml.cpp" />
    <ClCompile Include="src\core_bridge.c">
      <CompileAs>CompileAsC</CompileAs>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\feed.c">
      <CompileAs>CompileAsC</CompileAs>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <!-- Pinned to the exact 1.6 build CI resolved (run 36332867325,
      refs #64): a floating 1.6.* re-resolves every run and drifts. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <!-- C++/WinRT MSBuild support (midlrt.exe + cppwinrt.exe): without this,
      MIDL 3.0 .idl files fall through to the classic COM MIDL compiler,
      which fails with MIDL2025 near "namespace" (run 36328939162). -->
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="2.0.250303.1" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
